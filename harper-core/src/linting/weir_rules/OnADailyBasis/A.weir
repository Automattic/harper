# These modifiers take "a" before "basis"; retain the matched modifier's spelling.
expr modifier [daily, weekly, biweekly, (bi-weekly), (bi weekly), monthly, bimonthly, (bi-monthly), (bi monthly), yearly, biannual, (bi-annual), (bi annual), consolidated, continuous, contractual, friendly, net, general, periodic, permanent, random, regular, routine, temporary, trial]
expr main <(on @modifier basis), on>

let message "The definite article `a`/`an` is missing."
let description "Corrects `on daily/weekly/etc. basis` to `on a daily/weekly/etc. basis`."
let kind "Usage"
let becomes "on a"

# Every previously supported form except the removed misspelling.
test "on daily basis" "on a daily basis"
test "on weekly basis" "on a weekly basis"
test "on biweekly basis" "on a biweekly basis"
test "on bi-weekly basis" "on a bi-weekly basis"
test "on bi weekly basis" "on a bi weekly basis"
test "on monthly basis" "on a monthly basis"
test "on bimonthly basis" "on a bimonthly basis"
test "on bi-monthly basis" "on a bi-monthly basis"
test "on bi monthly basis" "on a bi monthly basis"
test "on yearly basis" "on a yearly basis"
test "on biannual basis" "on a biannual basis"
test "on bi-annual basis" "on a bi-annual basis"
test "on bi annual basis" "on a bi annual basis"
test "on consolidated basis" "on a consolidated basis"
test "on continuous basis" "on a continuous basis"
test "on contractual basis" "on a contractual basis"
test "on friendly basis" "on a friendly basis"
test "on net basis" "on a net basis"
test "on general basis" "on a general basis"
test "on periodic basis" "on a periodic basis"
test "on permanent basis" "on a permanent basis"
test "on random basis" "on a random basis"
test "on regular basis" "on a regular basis"
test "on routine basis" "on a routine basis"
test "on temporary basis" "on a temporary basis"
test "on trial basis" "on a trial basis"

# Original real-world tests.
test "Some of the observations will look naive and obvious for the people who work with Zig on daily basis" "Some of the observations will look naive and obvious for the people who work with Zig on a daily basis"
test "Gives report about the different type of product ordered on yearly basis and provided yearly comparsions about the profits and the loss." "Gives report about the different type of product ordered on a yearly basis and provided yearly comparsions about the profits and the loss."
test "On weekly basis, the models are retrained, plus the monitoring routines are performed as usual." "On a weekly basis, the models are retrained, plus the monitoring routines are performed as usual."
test "I'm able to extract this information by generating Category Reports on monthly basis in separate browser tabs and comparing them \"manually\"" "I'm able to extract this information by generating Category Reports on a monthly basis in separate browser tabs and comparing them \"manually\""
test "Patch release is released on bi-weekly basis." "Patch release is released on a bi-weekly basis."
test "Topics tracked in the repo are reviewed on biweekly basis in the Compound Developer Community Calls in Discord." "Topics tracked in the repo are reviewed on a biweekly basis in the Compound Developer Community Calls in Discord."
test "Calculates tutor payouts and donations on bimonthly basis, proportional to hours logged" "Calculates tutor payouts and donations on a bimonthly basis, proportional to hours logged"
test "Although I use to go for the must outings on biannual basis to relax myself getting fresh airs full of refreshes" "Although I use to go for the must outings on a biannual basis to relax myself getting fresh airs full of refreshes"
test "you can do transfer between your brokerage accounts ( taxable ) in Fidelity as a bill payment on bi-monthly basis" "you can do transfer between your brokerage accounts ( taxable ) in Fidelity as a bill payment on a bi-monthly basis"
test "I got ai india head ( products)  from a top tier company coaching me since last December on bi weekly basis." "I got ai india head ( products)  from a top tier company coaching me since last December on a bi weekly basis."
test "After you get the class under control this way, you can start calling home on bi monthly basis." "After you get the class under control this way, you can start calling home on a bi monthly basis."
test "Surprise surprise, its the same with the German consulate and the US consulate, which I deal with on bi annual basis along with 23 other national consular officials." "Surprise surprise, its the same with the German consulate and the US consulate, which I deal with on a bi annual basis along with 23 other national consular officials."
test "I will tell her to do this on bi-annual basis just to keep it working." "I will tell her to do this on a bi-annual basis just to keep it working."

# Casing, punctuation and already-correct phrases.
test "ON DAILY BASIS." "ON A DAILY BASIS."
test "On trial basis, we'll assess the outcome." "On a trial basis, we'll assess the outcome."
allows "on a daily basis"
allows "on a weekly basis"
allows "on a biweekly basis"
allows "on a bi-weekly basis"
allows "on a bi weekly basis"
allows "on a monthly basis"
allows "on a bimonthly basis"
allows "on a bi-monthly basis"
allows "on a bi monthly basis"
allows "on a yearly basis"
allows "on a biannual basis"
allows "on a bi-annual basis"
allows "on a bi annual basis"
allows "on a consolidated basis"
allows "on a continuous basis"
allows "on a contractual basis"
allows "on a friendly basis"
allows "on a net basis"
allows "on a general basis"
allows "on a periodic basis"
allows "on a permanent basis"
allows "on a random basis"
allows "on a regular basis"
allows "on a routine basis"
allows "on a temporary basis"
allows "on a trial basis"
allows "We review the figures on a daily basis."
allows "We evaluate this on discretionay basis."
