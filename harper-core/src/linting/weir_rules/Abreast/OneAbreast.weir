expr main [(one a breast)]

let message "Did you mean `one abreast`?"
let description "Corrects wrong variants of `one abreast`."
let kind "Spelling"
let becomes "one abreast"

test "When they're two a breast it often makes it unsafe to pass when it would have been safe one a breast." "When they're two a breast it often makes it unsafe to pass when it would have been safe one abreast."

# False positives / edge cases not yet handled

