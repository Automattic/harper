expr main (a lots)

let message "Are you confusing `a lot`, `lots` and `a lot's`? The contraction of `lot is` and `lot has` is `lot's`."
let description "Corrects `a lots` to `a lot's`, `a lot` or `lots`."
let kind "Punctuation"
let becomes ["a lot's", "a lot", "lots"]

# a lot has ...
test "a lots changed overtime, add latest depends support" "a lot's changed overtime, add latest depends support"
# a lot is ...
test "A lots changing around here!" "A lot's changing around here!"
# a lot (of) ...
test "Thanks a lots for your support." "Thanks a lot for your support."
test "Thanks a lots for your support." "Thanks lots for your support."
