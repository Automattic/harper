# Harper Language Development Recipes
# =====================================
# All recipes work for standard languages (german, portuguese, slovak, etc.)
# NOTE: English is a special case - these recipes do not work for English

# Build the language testing framework
language-build:
	cd harper-core/src/language/testing_framework && cargo build --release

# Test text for any language (without recompiling)
# Usage: just language-test german "your text here"
language-test language text:
	just language-build   # always: `cargo build --release` is incremental, so this also picks up edits to harper-core / the framework
	harper-core/src/language/testing_framework/target/release/harper-lang-test --language "{{language}}" --dict "harper-core/src/language/{{language}}/dictionary.dict" --annotations "harper-core/src/language/{{language}}/annotations.json" --text "{{text}}"

# Show metadata for a single word in any language
# Usage: just language-meta german "word"
language-meta language word:
	just language-build   # always: `cargo build --release` is incremental, so this also picks up edits to harper-core / the framework
	harper-core/src/language/testing_framework/target/release/harper-lang-test --language "{{language}}" --dict "harper-core/src/language/{{language}}/dictionary.dict" --annotations "harper-core/src/language/{{language}}/annotations.json" --word "{{word}}"

# Check word against hunspell
# Usage: just language-hunspell german "word"
language-hunspell language word:
	just language-build   # always: `cargo build --release` is incremental, so this also picks up edits to harper-core / the framework
	harper-core/src/language/testing_framework/target/release/harper-lang-test --language "{{language}}" --dict "harper-core/src/language/{{language}}/dictionary.dict" --annotations "harper-core/src/language/{{language}}/annotations.json" --text "{{word}}" --hunspell

# Show metadata for all words in text
# Usage: just language-meta-text german "text with multiple words"
language-meta-text language text:
	just language-build   # always: `cargo build --release` is incremental, so this also picks up edits to harper-core / the framework
	harper-core/src/language/testing_framework/target/release/harper-lang-test --language "{{language}}" --dict "harper-core/src/language/{{language}}/dictionary.dict" --annotations "harper-core/src/language/{{language}}/annotations.json" --metadata --text "{{text}}"

# Run basic dictionary tests for a language
# Usage: just language-dict-test german
language-dict-test language:
	just language-build   # always: `cargo build --release` is incremental, so this also picks up edits to harper-core / the framework
	harper-core/src/language/testing_framework/target/release/harper-lang-test --language "{{language}}" --dict "harper-core/src/language/{{language}}/dictionary.dict" --annotations "harper-core/src/language/{{language}}/annotations.json" --test

# Analyze language coverage against an expanded reference dictionary.
# Skips cleanly for languages that ship no reference word list.
# Usage: just language-coverage german
#        just language-coverage german 90   # fail below 90%
language-coverage language minimum="":
	#!/usr/bin/env bash
	set -eo pipefail

	# Always rebuild: `cargo build --release` is incremental, so a stale binary
	# (edited dictionary, annotations, or harper-core code) can never be used.
	just language-build
	bin="harper-core/src/language/testing_framework/target/release/harper-lang-test"

	# English is a special case: its dictionary lives at the crate root rather
	# than under language/.
	if [ "{{language}}" = "english" ]; then
		dict="harper-core/dictionary.dict"
		annotations="harper-core/annotations.json"
	else
		dict="harper-core/src/language/{{language}}/dictionary.dict"
		annotations="harper-core/src/language/{{language}}/annotations.json"
	fi

	# Prefer the reference list committed alongside the language; fall back to
	# /tmp so a large one can be supplied locally without committing it.
	expanded="harper-core/src/language/{{language}}/{{language}}_dictionary.dict.gz"
	if [ ! -f "${expanded}" ]; then
		expanded="/tmp/{{language}}_dictionary.dict.gz"
	fi

	args=(--language "{{language}}" --dict "${dict}" --annotations "${annotations}" \
	      --coverage --expanded-dict "${expanded}")
	if [ -n "{{minimum}}" ]; then
		args+=(--min-coverage "{{minimum}}")
	fi

	"${bin}" "${args[@]}"

# Analyze language efficiency (Harper word count vs base entries)
# Usage: just language-efficiency german
language-efficiency language:
	#!/usr/bin/env bash
	just language-build   # always: `cargo build --release` is incremental, so this also picks up edits to harper-core / the framework
	echo "📊 {{language}} Language Efficiency Analysis"
	echo "==========================================="
	
	# Determine dictionary path - English is special case
	if [ "{{language}}" = "english" ]; then
		dict_path="harper-core/dictionary.dict"
		annotations_path="harper-core/annotations.json"
	else
		dict_path="harper-core/src/language/{{language}}/dictionary.dict"
		annotations_path="harper-core/src/language/{{language}}/annotations.json"
	fi
	
	# Count base entries (lines with /)
	base_words=$(grep -c "/" "${dict_path}" || echo 0)
	
	# Get Harper's expanded word count
	harper_word_count=$(harper-core/src/language/testing_framework/target/release/harper-lang-test --language "{{language}}" --dict "${dict_path}" --annotations "${annotations_path}" 2>/dev/null | grep "Word count:" | awk '{print $NF}' || echo 0)
	# Clean up the word count (remove commas if present)
	harper_word_count=$(echo "${harper_word_count}" | tr -d ',')
	
	echo "   Base entries: ${base_words} (lines with /)"
	echo "   Harper expanded words: ${harper_word_count} (after affix expansion)"
	
	if [ "${base_words}" -gt 0 ] && [ "${harper_word_count}" -gt 0 ]; then
		efficiency=$(echo "scale=2; ${harper_word_count} / ${base_words}" | bc)
		echo "   Affix Efficiency: ${efficiency} expanded words per base entry"
		echo "   (Higher = more productive affix rules)"
		
		if (( $(echo "${efficiency} > 2.5" | bc) )); then
			echo "   ✅ Excellent efficiency - highly productive affix rules"
		elif (( $(echo "${efficiency} > 1.5" | bc) )); then
			echo "   🟡 Good efficiency - moderate affix rule productivity"
		else
			echo "   ⚠️  Low efficiency - consider improving affix rules"
		fi
	else
		echo "   ❌ Unable to calculate efficiency"
	fi
	echo "==========================================="

# Usage: just language-test-examples german
language-test-examples language:
	#!/usr/bin/env bash
	echo "📚 Testing example texts for {{language}}"
	echo "======================================="
	example_dir="harper-core/src/language/{{language}}/test_sources"; \
	if [ -d "${example_dir}" ]; then \
		for file in "${example_dir}"/*.md "${example_dir}"/*.txt; do \
			if [ -f "${file}" ]; then \
				filename=$(basename "${file}"); \
				filename="${filename%.*}"; \
				echo "Testing: ${filename}"; \
				text=$(cat "${file}"); \
				just language-test {{language}} "${text}" || true; \
				echo ""; \
			fi; \
		done; \
	else \
		echo "⚠️  No test_sources directory found for {{language}}"; \
	fi
	echo "======================================="

# Run the *real* curated linter (harper-cli) over a language's test_sources/,
# not just the spell checker. Surfaces grammar/capitalization false positives
# the `language-test*` recipes cannot see. Builds harper-cli with the language
# feature on first use.
# Usage: just language-lint-sources german
#        just language-lint-sources german .archive/german-language/test-sources
language-lint-sources language dir="":
	#!/usr/bin/env bash
	set -euo pipefail
	case "{{language}}" in
		german) dialect=de ;; portuguese) dialect=pt ;;
		slovak) dialect=sk ;; polish) dialect=pl ;;
		*) echo "unknown language {{language}}"; exit 1 ;;
	esac
	cli="{{justfile_directory()}}/target/release/harper-cli"
	echo "🔧 building harper-cli (feature harper-core/${dialect}) ..."
	cargo build --release -q -p harper-cli --features "harper-core/${dialect}"
	src_dir="{{dir}}"
	[ -n "${src_dir}" ] || src_dir="harper-core/src/language/{{language}}/test_sources"
	echo "📚 linting ${src_dir} as --dialect ${dialect}"
	echo "==========================================================="
	shopt -s nullglob
	total=0
	for f in "${src_dir}"/*.md "${src_dir}"/*.txt; do
		out="$("${cli}" lint --dialect "${dialect}" --quiet --no-color "${f}" 2>/dev/null || true)"
		n="$(printf '%s\n' "${out}" | grep -cE '\[(Capitalization|Style|Grammar|Miscellaneous|Spelling)::' || true)"
		total=$((total + n))
		printf '%-46s %3d lints\n' "$(basename "${f}")" "${n}"
		printf '%s\n' "${out}" | grep -oE '\[[A-Za-z]+::[A-Za-z]+\]' | sort | uniq -c \
			| sed 's/^/      /' || true
	done
	echo "==========================================================="
	echo "TOTAL: ${total} lints"

# Lint a single string or file with the curated linter for a language.
# Usage: just language-lint german "Die stadt ist schoen."
#        just language-lint german path/to/file.md
language-lint language text:
	#!/usr/bin/env bash
	set -euo pipefail
	case "{{language}}" in
		german) dialect=de ;; portuguese) dialect=pt ;;
		slovak) dialect=sk ;; polish) dialect=pl ;;
		*) echo "unknown language {{language}}"; exit 1 ;;
	esac
	cargo build --release -q -p harper-cli --features "harper-core/${dialect}"
	cli="{{justfile_directory()}}/target/release/harper-cli"
	if [ -f "{{text}}" ]; then
		"${cli}" lint --dialect "${dialect}" "{{text}}"
	else
		printf '%s' "{{text}}" | "${cli}" lint --dialect "${dialect}"
	fi

