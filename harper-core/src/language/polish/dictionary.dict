# Polish dictionary - basic words for testing
# Format: word/POS_flags

# Common words
i/CC
w/IN
na/IN
z/IN
do/IN
że/CC
jest/VBZ
nie/RB
tak/RB

# Polish-specific words with diacritics
ą/IN
ć/IN
ę/IN
ł/IN
ń/IN
ó/IN
ś/IN
ź/IN
ż/IN

# Basic nouns
człowiek/NN
dom/NN
książka/NN
miasto/NN
kobieta/NN
mężczyzna/NN
dziecko/NN

# Basic verbs
być/VB
mieć/VB
robić/VB
iść/VB
mówić/VB
pisać/VB
czytać/VB

# Basic adjectives
dobry/JJ
zły/JJ
duży/JJ
mały/JJ
nowy/JJ
stary/JJ
piękny/JJ

# Basic pronouns
