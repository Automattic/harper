# frozen_string_literal: true

UI.user_error!('Please run fastlane via `bundle exec`') unless FastlaneCore::Helper.bundler?

APPLE_TEAM_ID = 'PZYM8XX95Q'

GITHUB_REPO = 'Automattic/harper'
PROJECT_ROOT = File.expand_path('..', __dir__)

CODE_SIGNING_STORAGE_OPTIONS = {
  storage_mode: 's3',
  s3_bucket: 'a8c-fastlane-match',
  s3_region: 'us-east-2'
}.freeze

CODE_SIGNING_ENV_VARS = %w[
  MATCH_S3_ACCESS_KEY
  MATCH_S3_SECRET_ACCESS_KEY
  MATCH_PASSWORD
].freeze

ASC_API_KEY_ENV_VARS = %w[
  APP_STORE_CONNECT_API_KEY_KEY_ID
  APP_STORE_CONNECT_API_KEY_ISSUER_ID
  APP_STORE_CONNECT_API_KEY_KEY
].freeze

require 'fastlane/plugin/wpmreleasetoolkit'
require_relative 'lib/desktop_release'

EnvManager = Fastlane::Wpmreleasetoolkit::EnvManager

before_all do
  # Use a temporary signing keychain in CI.
  setup_ci

  # Initialize EnvManager with values supplied by the Buildkite agent.
  EnvManager.set_up(env_file_name: 'harper-desktop.env')
end

# Fetch the Developer ID Application certificate into the keychain.
# @param readonly [Boolean] Use existing certificates without creating new ones.
lane :set_up_signing do |readonly: true|
  CODE_SIGNING_ENV_VARS.each { |k| EnvManager.get_required_env!(k) }
  ASC_API_KEY_ENV_VARS.each { |k| EnvManager.get_required_env!(k) } unless readonly

  sync_code_signing(
    type: 'developer_id',
    platform: 'macos',
    team_id: APPLE_TEAM_ID,
    # Developer ID cert is team-wide; no per-app storage key needed.
    app_identifier: [],
    api_key: readonly ? nil : app_store_connect_api_key,
    readonly: readonly,
    **CODE_SIGNING_STORAGE_OPTIONS
  )
end

# Notarize a signed macOS package and staple its ticket.
# @param package [String] Path to the signed .app or .dmg.
lane :notarize_macos do |package:|
  ASC_API_KEY_ENV_VARS.each { |k| EnvManager.get_required_env!(k) }

  notarize(
    package: package,
    api_key: app_store_connect_api_key,
    print_log: true
  )
end

# Attach signed macOS artifacts to the tag's draft release.
# @see DesktopRelease.upload
lane :create_desktop_github_release do |tag:, dmg:, app_tarball:, app_signature:|
  upload_desktop_release_assets(tag: tag, assets: [dmg, app_tarball, app_signature])
end

# Attach the signed Windows installer to the tag's draft release.
# @see DesktopRelease.upload
lane :upload_windows_github_release do |tag:, installer:|
  upload_desktop_release_assets(tag: tag, assets: [installer])
end

# Upload draft assets using the CI GitHub credentials.
# @param assets [Array<String>] Paths relative to the repository root, or absolute paths.
private_lane :upload_desktop_release_assets do |tag:, assets:|
  client = Octokit::Client.new(
    access_token: EnvManager.get_required_env!('GITHUB_TOKEN'),
    auto_paginate: true
  )
  # Lane Ruby runs inside fastlane/, unlike actions which run at the repo root.
  asset_paths = assets.map { |path| File.expand_path(path, PROJECT_ROOT) }
  url = DesktopRelease.upload(client: client, repository: GITHUB_REPO, tag: tag, assets: asset_paths)
  UI.success("Uploaded desktop assets to #{url}")
end
